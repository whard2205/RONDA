# Copy to .env and fill in. Never commit .env.
ASSEMBLYAI_API_KEY=

# Filled in by `npm run publish:agent`.
AGENT_ID=

# Public HTTPS origin of THIS server, e.g. https://ronda.example.com
# AssemblyAI executes HTTP tools from its own servers and blocks private/loopback
# addresses, so localhost will NOT work for tool calls.
PUBLIC_URL=

# Shared secret AssemblyAI sends back on every tool call (x-ronda-key header).
# Generate with: node -e "console.log(crypto.randomUUID())"
TOOL_SECRET=

PORT=8787

# Optional: escalation notifications. Use a NEW bot, not a production one.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM Gateway model for the shift report. Free accounts can only reach
# qwen3.5-4b-32k-fast; larger models need activated credits.
LLM_MODEL=qwen3.5-4b-32k-fast
